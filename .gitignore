# Virtual environment
venv/

# Raw dataset (large binary files — download via Kaggle CLI)
data/raw/

# Preprocessed numpy arrays (auto-generated by preprocessing.py)
data/processed/

# Auxiliary external datasets (downloaded via Kaggle CLI)
data/external/

# Jupyter checkpoints
**/.ipynb_checkpoints/

# Python cache
__pycache__/
*.py[cod]

# OS files
.DS_Store
Thumbs.db

# Trained models (generated locally by src/KNN/knn.py and src/CNN/train_cnn.py)
models/

# Evaluation outputs (generated by src/CNN/evaluate_cnn.py)
reports/

# Gradio's runtime cache / flagged-example log (src/CNN/app_gradio.py)
.gradio/
